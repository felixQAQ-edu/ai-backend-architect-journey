<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ADR-002 锁定 Spring Boot 3.5.x；具体 patch 版按发布时点选最新 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>com.felix</groupId>
    <artifactId>chat-pipeline</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>chat-pipeline</name>
    <description>M1 Week 2 · Spring Boot + LangChain4j 流式骨架</description>

    <properties>
        <java.version>21</java.version>
        <!-- ADR-004 锁定 LangChain4j 1.11.x；Spring Boot 启动器目前是 beta 版本 -->
        <langchain4j.version>1.11.0-beta19</langchain4j.version>
    </properties>

    <dependencies>
        <!-- Web + SSE（SseEmitter 走 spring-web 的标准 Servlet 异步分支） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- LangChain4j 核心 + Spring Boot 自动装配 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-spring-boot-starter</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!-- OpenAI-compatible Provider（DeepSeek / OpenAI / Moonshot / Ollama 都走这套） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai-spring-boot-starter</artifactId>
            <version>${langchain4j.version}</version>
        </dependency>

        <!-- Bean Validation：未来给 ChatRequest DTO 加 @NotBlank 等约束时启用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator：M1 后续做 Token 用量指标 / 健康检查时用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ===== Step 1.1: 持久化基座 (M1 Week 3) ===== -->

        <!-- JPA + Hibernate,业务实体的 ORM 层 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- H2 数据库,file 模式跨重启持久化 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway,SQL migration 版本管理 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
