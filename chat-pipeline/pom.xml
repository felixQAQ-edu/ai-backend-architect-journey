<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ADR-002 锁定 Spring Boot 3.5.x;具体 patch 版按发布时点选最新 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/>
    </parent>

    <groupId>com.felix</groupId>
    <artifactId>chat-pipeline</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>chat-pipeline</name>
    <description>M1 Week 2 · Spring Boot + LangChain4j 流式骨架</description>

    <properties>
        <java.version>21</java.version>

        <!--
            ADR-004 锁定 LangChain4j 1.11.x。
            注意 LangChain4j 是双轨版本号(LEARNING-NOTES 笔记 6):
              - 核心 / HTTP client 实现走稳定线:1.11.0
              - Spring Boot 集成走 beta 线:1.11.0-beta19
            两条线是官方对齐的同一 release,不是版本不一致。
        -->
        <langchain4j.spring.version>1.11.0-beta19</langchain4j.spring.version>
        <langchain4j.core.version>1.11.0</langchain4j.core.version>
    </properties>

    <dependencies>
        <!-- Web + SSE(SseEmitter 走 spring-web 的标准 Servlet 异步分支) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- LangChain4j 核心 + Spring Boot 自动装配 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-spring-boot-starter</artifactId>
            <version>${langchain4j.spring.version}</version>
        </dependency>

        <!-- OpenAI-compatible Provider(DeepSeek / OpenAI / Moonshot / Ollama 都走这套) -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai-spring-boot-starter</artifactId>
            <version>${langchain4j.spring.version}</version>
        </dependency>

        <!--
            === HTTP Client adapter workaround (2026-05-15, M1 Week 3 Day 3→4) ===

            背景:starter 默认装载 spring-restclient adapter,1.11.0-beta19 版本在
                 macOS + JDK 21 streaming 路径下会同步抛 UnresolvedAddressException
                 (35ms 内失败,根本不出网络),所有真实 LLM 调用无法跑通。

            诊断锁定:RawJdkHttpClientTest 用 20 行纯 JDK HttpClient 直打
                     api.openai.com 返回 200,证明 JDK 本身完全正常。
                     锅在 spring-restclient adapter 1.11.0-beta19。

            修复方案:加入 jdk client adapter,通过 config/LangChain4jHttpClientConfig
                     里的同名 bean 覆盖 starter 默认的 builder。

            !!! 重要 !!!
            不能用 <exclusions> 把 langchain4j-http-client-spring-restclient 排掉。
            starter 的 AutoConfig.java:155 字节码硬编码引用了 SpringRestClient class,
            排除会引发 NoClassDefFoundError。
            正确做法见 com.felix.chatpipeline.config.LangChain4jHttpClientConfig:
            提供一个名字精确叫 openAiStreamingChatModelHttpClientBuilder 的 @Bean,
            借助 starter 的 @ConditionalOnMissingBean(names=...) 让 starter 的
            硬编码版本跳过(那个有 bug 的工厂方法压根不会被调用)。

            撤回条件:
              - LangChain4j 修复 spring-restclient streaming 路径(关注
                langchain4j-spring 仓库 release notes)
              - 升级到 1.12+ 时重新评估 starter 的 HTTP client 装载方式

            详见 LEARNING-NOTES 笔记 6 + ADR-004 已知代价补遗。
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-http-client-jdk</artifactId>
            <version>${langchain4j.core.version}</version>
        </dependency>

        <!-- Bean Validation:未来给 ChatRequest DTO 加 @NotBlank 等约束时启用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator:M1 后续做 Token 用量指标 / 健康检查时用 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ===== Step 1.1: 持久化基座 (M1 Week 3) ===== -->

        <!-- JPA + Hibernate,业务实体的 ORM 层 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- H2 数据库,file 模式跨重启持久化 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway,SQL migration 版本管理 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>